# Copie este ficheiro para ".env" e ajuste o IP.
#
# Deve ser o IP da máquina onde o tcl_backend está a correr, na mesma rede
# Wi-Fi/local do telemóvel ou emulador (NÃO usar "localhost" — o telemóvel
# não consegue resolver o localhost do computador).
#
# Exemplo (Windows: correr "ipconfig" e usar o IPv4 do adaptador de rede):
EXPO_PUBLIC_API_URL=http://192.168.1.141:3000/api
